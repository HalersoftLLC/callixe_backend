# Copy to .env.development (local) or .env.production (live) and fill in values.
# This is the only env file committed to git.

NODE_ENV=development
PORT=3000

FRONTEND_URL=

# Admin app origin (no trailing slash) and the single admin login
ADMIN_URL=
ADMIN_EMAIL=
# bcrypt hash of the admin password, never the password itself
ADMIN_PASSWORD_HASH=
# At least 32 random characters
JWT_SECRET=

# Product images. local = ./uploads served at /uploads (development and the
# production Droplet, whose disk is permanent). spaces = DigitalOcean Spaces.
STORAGE_DRIVER=local
# Base URL of stored images, no trailing slash.
# local: http://localhost:3000/uploads  spaces: https://<bucket>.<region>.cdn.digitaloceanspaces.com
STORAGE_PUBLIC_URL=http://localhost:3000/uploads
# Only when STORAGE_DRIVER=spaces
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=

DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SSL=false
# PEM CA certificate of the database (DigitalOcean: "Download CA certificate").
# Only with DB_SSL=true. One line with \n between lines is accepted.
DB_CA_CERT=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd

# Proxies in front of the app (0 locally; DigitalOcean: 1, verify via logged IP)
TRUST_PROXY_HOPS=1

# Brevo (transactional email)
BREVO_API_KEY=
# Must be a sender verified in Brevo
EMAIL_FROM=
EMAIL_FROM_NAME=
# Optional: inbox for customer replies. Blank = replies go to EMAIL_FROM.
EMAIL_REPLY_TO=
# Store owner gets a hidden copy (BCC) of every order confirmation. Blank = none.
ORDER_NOTIFY_EMAIL=
